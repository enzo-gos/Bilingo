.auth-container
  h1.auth-title = t('auth.sign_in.title')
  .auth-form
    = simple_form_for resource, url: session_path(resource), defaults: { input_html: { class: 'auth-form-input' } } do |f|
      = f.input :email,
                required: false,
                autofocus: true,
                placeholder: 'Enter your email address'
      = f.input :password,
                required: false,
                placeholder: 'Enter your password'
      = f.button :submit, 'Sign in', class: 'submit-btn'

    = link_to "Forgot your password?", '#forgot', class: 'forgot-password-btn'

    .alternative-devider
      .line
      = t('auth.sign_in.or')
      .line

    .auth-actions
      = button_to user_facebook_omniauth_authorize_path, class: 'auth-btn facebook-btn', method: :post, data: { turbo: false } do
        = inline_svg_tag 'icons/facebook_icon.svg', class: 'auth-btn-icon'
      .button.auth-btn.google-btn
        = inline_svg_tag 'icons/google_icon.svg', class: 'auth-btn-icon'

