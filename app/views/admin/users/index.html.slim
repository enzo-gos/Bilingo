.user-container
  h1.user-title Manage Users
  hr.mb-10.mt-4
  .search-container
    .search-input-wrapper
      .search-icon
        = mi.shape(:search).round.md_24
      input.search-input[type="email" placeholder="Search for anything..."]

    = link_to new_admin_user_path, class: 'create-btn'
    	span.whitespace-nowrap Add Employee
    	= mi.shape(:add_circle).round.md_18

  .table-container
    table.management-table
      thead.table-heading
        - @employees.each do |user|
          tr
            th [scope="col"]
              | ID
            th [scope="col"]
              | Email
            th [scope="col"]
              | Username
            th [scope="col"]
              | Stories
            th [scope="col"]
              | Comments
            th [scope="col"]
              | Role
            th [scope="col"]
              | Actions
      tbody.table-body
        - @employees.each do |user|
          tr
            td = user.id
            td = user.email
            td = user.fullname
            td = user.stories.size
            td = user.comments.size
            td = user.roles.length > 0 ? user.roles.pluck(:name).join(', ') : 'User'
            td
              .action-buttons
                - if user.active
                  = button_to ban_admin_user_path(user.id), method: :patch, data: { turbo_confirm: 'Are you sure you want to ban this user?' }, class: 'ban-btn', disabled: (current_user == user) do
                    = mi.shape(:block).css_class('outlined action-icon')
                - else
                  = button_to unban_admin_user_path(user.id), method: :patch, data: { turbo_confirm: 'Are you sure you want to unlock this user?' }, class: 'ban-btn', disabled: (current_user == user) do
                    = mi.shape(:lock_open).css_class('outlined action-icon')

                = button_to admin_user_path(user.id), method: :delete, data: { turbo_confirm: 'Are you sure you want to delete this user?' }, class: 'delete-btn', disabled: (user.has_role? :admin || current_user == user) do
                  = mi.shape(:delete).css_class('outlined action-icon')
                = link_to edit_admin_user_path(user.id), data: { turbo_frame: '_top' }, class: 'edit-btn' do
                  = mi.shape(:edit).css_class('outlined action-icon')

        - if @employees.empty?
          tr
            td.empty-state colspan='6'
              | There are no stories available
    - if @pagy && @pagy.pages > 1
      .navigation
        == pagy_nav(@pagy)
