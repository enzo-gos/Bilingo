.reader.story-details data-controller='request-form'
  .story-heading
    .story-cover
      = image_tag @story.cover_image
    .story-info
      .story-title = @story.name
      .story-author = t('story_details.by_author', author_name: @story.author.nickname)
      .story-tags
        - @story.tag_list.each do |tag|
          .story-tag-item = tag
      .story-analysis
        .analysis-item
          .analysis-heading
            = mi.shape(:visibility).css_class('analysis-icon outlined')
            = t('story_details.reads')
          .analysis-content
            = number_to_human(@story.views, units: { thousand: 'K', million: 'M' })

        .analysis-item
          .analysis-heading
            = mi.shape(:comment).css_class('analysis-icon outlined')
            = t('story_details.comments')
          .analysis-content
            = number_to_human(@story.comments, units: { thousand: 'K', million: 'M' })

        .analysis-item
          .analysis-heading
            = mi.shape(:format_list_bulleted).css_class('analysis-icon')
            = t('story_details.chapters')
          .analysis-content
            = @story.chapters.size
      .actions-group
        - if @request.accepted?
          .status-tag.accept-status = t("report_story.status.#{@request.status}")
        - elsif @request.closed?
          .status-tag.close-status = t("report_story.status.#{@request.status}")
        - elsif @request.handled?
          .status-tag.pending-status = t("report_story.status.#{@request.status}")
        - else
          = button_to 'Mark as solved', solved_story_report_path(story_id: @story.id, id: @request.id), method: :patch, data: { turbo_confirm: t('report_story.confirm_mark_as_solved') }, class: 'story-accept-btn'
        = link_to edit_writer_story_path(@story), class: 'visit-btn', target: '_blank' do
          = mi.shape(:edit).md_18
  .story-description
    .report-title = @request.title
    .report-reason = @request.reason

    i.report-reporter = "by #{@request.requester.fullname}"
