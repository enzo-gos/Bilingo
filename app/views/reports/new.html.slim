.reader.story-details data-controller='request-form'
  .story-heading
    .story-cover
      = image_tag @story.cover_image
    .story-info
      .story-title = @story.name
      .story-author = t('story_details.by_author', author_name: @story.author.fullname)
      .story-tags
        - @story.tag_list.each do |tag|
          .story-tag-item = tag
      .story-analysis
        .analysis-item
          .analysis-heading
            = mi.shape(:visibility).css_class('analysis-icon outlined')
            = t('story_details.reads')
          .analysis-content
            = number_to_human(@story.views, units: { thousand: 'K', million: 'M' })

        .analysis-item
          .analysis-heading
            = mi.shape(:comment).css_class('analysis-icon outlined')
            = t('story_details.comments')
          .analysis-content
            = number_to_human(@story.comments, units: { thousand: 'K', million: 'M' })

        .analysis-item
          .analysis-heading
            = mi.shape(:format_list_bulleted).css_class('analysis-icon')
            = t('story_details.chapters')
          .analysis-content
            = @story.chapters.size

  .story-description
    h1.story-title.mb-6 Report Request
    = simple_form_for @report_request, url: story_reports_path(story_id: @story), method: :post, html: { class: 'delete-form' } do |f|
      = f.input :title, input_html: { class: 'form-input', placeholder: 'Enter the title' }, label_html: { class: 'form-label' }
      .form-trix
        = f.rich_text_area :reason, class: 'trix-input'
      = f.button :submit, 'Send Request', class: 'submit-btn'
